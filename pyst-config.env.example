# Copy this file to `pyst-config.env` and replace placeholder values as needed.
# PyST loads settings from environment variables and from `pyst-config.env`.

# Database
PyST_db_backend=postgres
PyST_db_user=change-me
PyST_db_pass=change-me
PyST_db_host=localhost
PyST_db_port=5432
PyST_db_name=PyST

# API and web app
PyST_auth_token=change-me
PyST_admin_session_secret=change-me
# Set this when callback URLs or generated links must use a public hostname.
PyST_public_base_url=http://localhost:8000

# Direct GitLab login
PyST_gitlab_url=https://gitlab.com
PyST_gitlab_client_id=change-me
PyST_gitlab_client_secret=change-me
PyST_gitlab_admin_group=your-group-or-project
PyST_gitlab_admin_min_access_level=40
PyST_gitlab_contributor_group=your-group-or-project
PyST_gitlab_contributor_min_access_level=30
PyST_gitlab_oauth_scope=read_api

# Trusted backend login
# Leave these unset if you do not use backend-managed login.
PyST_contributor_backend_base_url=http://localhost:8000
PyST_contributor_backend_name=BONSAI

# Optional admin allowlist for backend-managed login
# PyST_admin_backend_allowed_emails=["admin@example.com"]

# Search
PyST_typesense_url=http://localhost:8108
PyST_typesense_api_key=change-me
PyST_typesense_embedding_model=ts/all-MiniLM-L12-v2
PyST_typesense_exclude_if_missing_for_language=true
PyST_typesense_prefix=

# UI languages as a JSON string
PyST_languages=["en", "de", "es", "fr", "pt", "it", "da"]
